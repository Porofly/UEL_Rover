{
  "configById": {
    "DiagnosticSummary!rover": {
      "minLevel": 0,
      "pinnedIds": [],
      "hardwareIdFilter": "",
      "topicToRender": "/diagnostics",
      "sortByLevel": true
    },
    "DiagnosticStatusPanel!rover": {
      "topicToRender": "/diagnostics",
      "selectedHardwareId": "OpenRB-150",
      "selectedName": "uel_rover/control_board",
      "splitFraction": 0.5
    },
    "Indicator!drive_mode": {
      "path": "/drive_mode.data",
      "style": "background",
      "fallbackColor": "#6b6b6b",
      "fallbackLabel": "NO LINK",
      "rules": [
        { "operator": "=", "rawValue": "AUTO", "color": "#2e7d32", "label": "AUTO" },
        { "operator": "=", "rawValue": "RC",   "color": "#f9a825", "label": "RC" },
        { "operator": "=", "rawValue": "STOP", "color": "#c62828", "label": "STOP" }
      ]
    },
    "Plot!wheel_rpm": {
      "paths": [
        { "value": "/wheel_velocity.data[0]", "enabled": true, "timestampMethod": "receiveTime", "label": "left rpm" },
        { "value": "/wheel_velocity.data[1]", "enabled": true, "timestampMethod": "receiveTime", "label": "right rpm" }
      ],
      "minYValue": -60,
      "maxYValue": 60,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "isSynced": true,
      "xAxisVal": "timestamp",
      "sidebarDimension": 240,
      "followingViewWidth": 30
    },
    "Teleop!gcs": {
      "topic": "/gcs/teleop",
      "publishRate": 10,
      "autoSendStopOnRelease": true,
      "upButton":    { "field": "linear-x",  "value": 1 },
      "downButton":  { "field": "linear-x",  "value": -1 },
      "leftButton":  { "field": "angular-z", "value": 1 },
      "rightButton": { "field": "angular-z", "value": -1 }
    },
    "Publish!speed_down": {
      "topicName": "/gcs/speed_step",
      "datatype": "std_msgs/msg/Int8",
      "buttonText": "−",
      "buttonTooltip": "속도 한 단계 내림",
      "buttonColor": "#1565c0",
      "advancedView": false,
      "value": "{\n  \"data\": -1\n}"
    },
    "Publish!speed_up": {
      "topicName": "/gcs/speed_step",
      "datatype": "std_msgs/msg/Int8",
      "buttonText": "+",
      "buttonTooltip": "속도 한 단계 올림",
      "buttonColor": "#1565c0",
      "advancedView": false,
      "value": "{\n  \"data\": 1\n}"
    },
    "RawMessages!gcs_speed": {
      "topicPath": "/gcs/speed.data",
      "fontSize": 18,
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false
    },
    "RawMessages!cmd_vel_out": {
      "topicPath": "/cmd_vel_out",
      "diffEnabled": false,
      "diffMethod": "custom",
      "diffTopicPath": "",
      "showFullMessageForDiff": false
    },
    "RosOut!log": {
      "searchTerms": [],
      "minLogLevel": 2,
      "nameFilter": {}
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": { "speed": 1 },
  "layout": {
    "direction": "row",
    "first": {
      "direction": "column",
      "first": "DiagnosticSummary!rover",
      "second": "DiagnosticStatusPanel!rover",
      "splitPercentage": 30
    },
    "second": {
      "direction": "column",
      "first": {
        "direction": "row",
        "first": "Indicator!drive_mode",
        "second": "Plot!wheel_rpm",
        "splitPercentage": 25
      },
      "second": {
        "direction": "row",
        "first": {
          "direction": "column",
          "first": {
            "direction": "row",
            "first": "Publish!speed_down",
            "second": {
              "direction": "row",
              "first": "RawMessages!gcs_speed",
              "second": "Publish!speed_up",
              "splitPercentage": 67
            },
            "splitPercentage": 25
          },
          "second": "Teleop!gcs",
          "splitPercentage": 28
        },
        "second": {
          "direction": "column",
          "first": "RawMessages!cmd_vel_out",
          "second": "RosOut!log",
          "splitPercentage": 40
        },
        "splitPercentage": 40
      },
      "splitPercentage": 45
    },
    "splitPercentage": 38
  }
}
